#include <stdio.h>

struct Book
{
    char title[50];
    char author[50];
    int isbn;
    int price;
};

int main()
{
    int n, i;

    scanf("%d", &n);

    struct Book b[n + 5];

    for(i = 0; i < n; i++)
    {
        scanf(" %[^\n]", b[i].title);
        scanf(" %[^\n]", b[i].author);
        scanf("%d", &b[i].isbn);
        scanf("%d", &b[i].price);
    }

    for(i = 0; i < n; i++)
    {
        printf("%s %s %d %d\n",
               b[i].title,
               b[i].author,
               b[i].isbn,
               b[i].price);
    }

    return 0;
}
